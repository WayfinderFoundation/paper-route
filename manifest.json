{
  "manifest_version": 3,
  "name": "Paper Route",
  "short_name": "Paper Route",
  "version": "0.2.3",
  "description": "Delta-neutral papertrade ↔ Hyperliquid hedging that follows papertrade's queue, with a Hyperliquid order-flow overlay. By Wayfinder.",
  "key": "",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Paper Route",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://exchange.papertrade.xyz/*",
    "https://api.hyperliquid.xyz/*",
    "wss://api.hyperliquid.xyz/*",
    "https://rpc.hyperliquid.xyz/*",
    "https://wayfinder.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "chart-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "content.js",
        "hedge-ui.js",
        "tpsl-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "hud.css",
        "assets/GeneralSans-Variable.woff2",
        "assets/icon16.png"
      ],
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ]
    }
  ]
}
